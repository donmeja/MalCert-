<script>
    // Prevent unauthorized access
    if (localStorage.getItem("isLoggedIn") !== "true") {
        location.replace("login.html");
    }
</script>

<div class="container">
    <h1 id="welcomeTitle"></h1>
    <p id="welcomeMessage"></p>
</div>

<script>
    const userName = localStorage.getItem("studentName") || "Student";

    const welcomeTitle = document.getElementById("welcomeTitle");
    const welcomeMessage = document.getElementById("welcomeMessage");

    // Check if this is the first login
    if (localStorage.getItem("hasLoggedInBefore") === "true") {
        // Returning user
        welcomeTitle.textContent = `Welcome back, ${userName}!`;
        welcomeMessage.textContent = "Good to see you again on MalCert.";
    } else {
        // First login
        welcomeTitle.textContent = `Welcome, ${userName}!`;
        welcomeMessage.textContent = "Glad to see you on MalCert.";

        // Mark that the user has logged in before
        localStorage.setItem("hasLoggedInBefore", "true");
    }

    // Redirect after 2 seconds
    setTimeout(() => {
        window.location.href = "subjects.html";
    }, 2000);
</script>